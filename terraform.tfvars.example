# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

shop_name = "Sarah's Cookies"

# Pickup date = max orders for that date
pickup_slots = {
  "2026-12-12" = 10
  "2026-12-19" = 15
  "2026-12-23" = 15
}

# Generate one with: openssl rand -hex 16
admin_key = "replace-with-a-long-random-string"

budget_email = "you@example.com"
